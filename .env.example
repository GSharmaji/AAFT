# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
#
# How to get these:
#   1. Create a LinkedIn app:            https://www.linkedin.com/developers/apps
#   2. Add the "Community Management API" / "Share on LinkedIn" products.
#   3. Generate an access token with the w_organization_social (for a Company
#      Page) or w_member_social (for a personal profile) scope.
#   4. Find your author URN:
#        - Company Page: urn:li:organization:<your_org_id>
#        - Personal:     urn:li:person:<your_member_id>  (from the /userinfo endpoint)

LINKEDIN_ACCESS_TOKEN=paste_your_token_here
LINKEDIN_AUTHOR_URN=urn:li:organization:00000000

# Optional — bump this if LinkedIn deprecates the default API version (YYYYMM):
# LINKEDIN_VERSION=202409
