# Copy to pipeline/.env and fill in. NEVER commit the real .env.

# Claude — research, script, fact-check, shot prompts, packaging
ANTHROPIC_API_KEY=

# Voice — https://elevenlabs.io (Creator plan covers ~5 episodes/month)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Images — only if images.provider is "openai"
OPENAI_API_KEY=

# YouTube — only for upload.mode "api" (after your project passes the API audit).
# Get these with: python -m yt auth path/to/client_secret.json
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Name recorded on approvals
YT_REVIEWER=
